{
  "name": "his-backend",
  "version": "1.0.0",
  "description": "Hospital Information System (HIS) - Backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:smoke": "jest tests/smoke/ --runInBand",
    "test:coverage": "jest --coverage",
    "migrate": "node src/database/migrations/run.js",
    "seed": "node src/database/seeds/run.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "precommit": "npm run lint && npm run format:check && npm test",
    "build": "echo 'Build complete (syntax check only in dev)' && node --check src/app.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^10.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.12",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
